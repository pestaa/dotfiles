background-opacity = 0.9
background-opacity-cells = true
cursor-style-blink = false
cursor-style = block
font-size = 13
keybind = global:super+0=toggle_quick_terminal
keybind = global:super+enter=new_window
keybind = global:super+`=toggle_quick_terminal
keybind = performable:page_up=scroll_page_fractional:-0.5
keybind = performable:page_down=scroll_page_fractional:0.5
keybind = performable:super+h=goto_split:left
keybind = performable:super+j=goto_split:bottom
keybind = performable:super+k=goto_split:top
keybind = performable:super+l=goto_split:right
keybind = performable:super+shift+h=new_split:left
keybind = performable:super+shift+j=new_split:down
keybind = performable:super+shift+k=new_split:up
keybind = performable:super+shift+l=new_split:right
keybind = performable:super+ctrl+h=resize_split:left,20
keybind = performable:super+ctrl+j=resize_split:down,20
keybind = performable:super+ctrl+k=resize_split:up,20
keybind = performable:super+ctrl+l=resize_split:right,20
maximize = true
mouse-hide-while-typing = true
quick-terminal-position = top
quick-terminal-size = 55%
quit-after-last-window-closed = false
shell-integration-features = no-cursor
theme = light:GitHub Light Default, dark:GitHub Dark High Contrast
window-decoration = none
window-padding-color = background
window-padding-x = 4
window-padding-y = 4
